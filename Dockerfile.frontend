# ── Frontend Dockerfile ───────────────────────────────────────────────────────
# Multi-stage build for production Next.js container.

# Stage 1: Dependencies
FROM node:20-alpine AS deps

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --prefer-offline 2>/dev/null || npm install

# Stage 2: Builder
FROM node:20-alpine AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN npm run build

# Stage 3: Runtime
FROM node:20-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

# Security: non-root user
RUN addgroup --system --gid 1001 windsight && \
    adduser --system --uid 1001 windsight

COPY --from=builder --chown=windsight:windsight /app/.next/standalone ./
COPY --from=builder --chown=windsight:windsight /app/.next/static ./.next/static

USER windsight

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
